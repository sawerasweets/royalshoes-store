# ROYAL SHOES — BLACK & GOLD EDITION
# DOMAIN: royalshoes.store
# Copy this file to .env or paste into Render.com Environment Variables

# 1. Supabase Cloud PostgreSQL Database URI
# Copy from Supabase -> Project Settings -> Database -> Connection URI (Transaction or Session mode)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Security JWT Secret Key
JWT_SECRET="royalshoes_luxury_secret_jwt_key_2026_ateliertoken"

# 3. Public Website URL
NEXT_PUBLIC_APP_URL="https://royalshoes.store"

# 4. Brand & Store Metadata
NEXT_PUBLIC_STORE_NAME="ROYAL SHOES"
NEXT_PUBLIC_STORE_TAGLINE="STEP INTO ELEGANCE"
NEXT_PUBLIC_STORE_PHONE="03481702710"
NEXT_PUBLIC_STORE_WHATSAPP="923481702710"
NEXT_PUBLIC_STORE_COUNTRY="Pakistan"

# 5. Commerce & Logistics Rules
FREE_SHIPPING_THRESHOLD="5000"
STANDARD_SHIPPING_FEE="250"

# 6. Default Admin Credentials
# Email: admin@royalshoes.store (or admin@sawera.com)
# Password: SaweraAdmin2026!
NODE_ENV="production"
